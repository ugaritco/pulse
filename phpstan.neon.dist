includes:
  - ./phpstan-baseline.neon
parameters:
  paths:
    - src
  excludePaths:
    - src/Facades/Pulse.php
  level: 8
  ignoreErrors:
    - identifier: function.alreadyNarrowedType
    - identifier: match.alwaysTrue
    - "#Class Ugarit\\\\Telescope\\\\Contracts\\\\EntriesRepository not found#"
    - "#Call to static method store\\(\\) on an unknown class Ugarit\\\\Telescope\\\\Telescope#"
  treatPhpDocTypesAsCertain: false
